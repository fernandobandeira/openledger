{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenLedger write path",
    "description": "Spike 021. The ADR-0013 write-path contract, generated by aide.",
    "version": "0.0.0"
  },
  "paths": {
    "/v1/transactions": {
      "post": {
        "tags": [
          "transactions"
        ],
        "summary": "Record a transaction.",
        "description": "Claims the idempotency key and, in the same database transaction, writes what it causes. A replay of the same key with the same body returns the original answer and `Idempotency-Replayed: true`.",
        "operationId": "createTransaction",
        "requestBody": {
          "description": "The body of `POST /v1/transactions`.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Accepted, or replayed with the original stored result.",
            "headers": {
              "Idempotency-Replayed": {
                "description": "`true` when this call replayed an existing event rather than claiming the key. The body is byte-identical either way.",
                "style": "simple",
                "required": true,
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionAccepted"
                }
              }
            }
          },
          "422": {
            "description": "The idempotency key was reused with a different body. Correct the request and resend; nothing was written (ADR-0013 §2).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such account in this tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/{id}/balance": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Read one account's balance.",
        "operationId": "getAccountBalance",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "description": "Account id.",
            "required": true,
            "schema": {
              "description": "Account id.",
              "type": "string",
              "format": "uuid"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "description": "The current balance of one account, summed over its stripes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountBalance"
                }
              }
            }
          },
          "422": {
            "description": "The idempotency key was reused with a different body. Correct the request and resend; nothing was written (ADR-0013 §2).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such account in this tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountBalance": {
        "description": "The current balance of one account, summed over its stripes.",
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance": {
            "description": "Minor units. May be negative.",
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "currency",
          "balance"
        ]
      },
      "AccountPath": {
        "description": "`aide` derives path parameters from an *object* schema, so the path segment\n has to be a named struct field; `Path<Uuid>` alone carries no name.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Account id.",
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "CreateTransactionRequest": {
        "description": "The body of `POST /v1/transactions`.",
        "type": "object",
        "properties": {
          "effective_at": {
            "description": "When the movement is deemed to have happened, RFC 3339.",
            "type": "string",
            "format": "date-time"
          },
          "idempotency_key": {
            "description": "Caller-supplied replay key. Scoped to the tenant; never expires (ADR-0013 §2).",
            "type": "string",
            "examples": [
              "5f0a1e4c-1c0f-4b1e-8f9d-2b7a9f0e4c11"
            ],
            "minLength": 1
          },
          "postings": {
            "description": "At least one posting.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Posting"
            },
            "minItems": 1
          }
        },
        "required": [
          "idempotency_key",
          "effective_at",
          "postings"
        ]
      },
      "Posting": {
        "description": "One leg of a transaction. Amounts are in minor units and always positive;\n direction is carried by `source` / `destination`, never by the sign.",
        "type": "object",
        "properties": {
          "amount": {
            "description": "Minor units. Positive.",
            "type": "integer",
            "format": "int64",
            "examples": [
              25000
            ],
            "minimum": 1
          },
          "currency": {
            "description": "ISO-4217 alphabetic code.",
            "type": "string",
            "examples": [
              "USD"
            ],
            "maxLength": 3,
            "minLength": 3
          },
          "destination": {
            "description": "Account the value arrives at.",
            "type": "string",
            "examples": [
              "liabilities:customer:9f3a"
            ]
          },
          "source": {
            "description": "Account the value leaves.",
            "type": "string",
            "examples": [
              "assets:cash:usd"
            ]
          }
        },
        "required": [
          "source",
          "destination",
          "amount",
          "currency"
        ]
      },
      "ProblemDetail": {
        "description": "A problem document. `type` is a stable machine-readable identifier.",
        "type": "object",
        "properties": {
          "type": {
            "description": "Stable error identifier, e.g. `idempotency_key_reused_with_different_body`.",
            "type": "string",
            "examples": [
              "idempotency_key_reused_with_different_body"
            ]
          },
          "detail": {
            "description": "Human-readable explanation. Not stable; do not parse.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "detail"
        ]
      },
      "TransactionAccepted": {
        "description": "The stored result of an accepted write: the event, and the transaction it caused.",
        "type": "object",
        "properties": {
          "event_id": {
            "description": "The `ledger_events` row this call claimed or replayed.",
            "type": "string",
            "format": "uuid"
          },
          "transaction_id": {
            "description": "The transaction the event caused. **`null` for the majority of accepted\n operations, which write no transaction at all** (ADR-0013 §2).",
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "event_id"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "transactions",
      "description": "The write path."
    },
    {
      "name": "accounts",
      "description": "Reads."
    }
  ]
}
