  "components": {
    "schemas": {
      "AccountBalance": {
        "type": "object",
        "description": "The current balance of one account, summed over its stripes.",
        "required": [
          "account_id",
          "currency",
          "balance"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance": {
            "type": "integer",
            "format": "int64",
            "description": "Minor units. May be negative."
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "description": "The body of `POST /v1/transactions`.",
        "required": [
          "idempotency_key",
          "effective_at",
          "postings"
        ],
        "properties": {
          "effective_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the movement is deemed to have happened, RFC 3339."
          },
          "idempotency_key": {
            "type": "string",
            "description": "Caller-supplied replay key. Scoped to the tenant; never expires (ADR-0013 §2).",
            "example": "5f0a1e4c-1c0f-4b1e-8f9d-2b7a9f0e4c11",
            "minLength": 1
          },
          "postings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Posting"
            },
            "description": "At least one posting.",
            "minItems": 1
          }
        }
      },
      "Posting": {
        "type": "object",
        "description": "One leg of a transaction. Amounts are in minor units and always positive;\ndirection is carried by `source` / `destination`, never by the sign.",
        "required": [
          "source",
          "destination",
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "Minor units. Positive.",
            "example": 25000,
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "description": "ISO-4217 alphabetic code.",
            "example": "USD",
            "maxLength": 3,
            "minLength": 3
          },
          "destination": {
            "type": "string",
            "description": "Account the value arrives at.",
            "example": "liabilities:customer:9f3a"
          },
          "source": {
            "type": "string",
            "description": "Account the value leaves.",
            "example": "assets:cash:usd"
          }
        }
      },
      "TransactionAccepted": {
        "type": "object",
        "description": "The stored result of an accepted write: the event, and the transaction it caused.",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "description": "The `ledger_events` row this call claimed or replayed."
          },
          "transaction_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The transaction the event caused. **`null` for the majority of accepted\noperations, which write no transaction at all** (ADR-0013 §2)."
          }
        }
      }
    }
