# Rust
/target/
**/*.rs.bk

# The built binary at the ROOT, and only there. Without the leading slash this
# pattern matches at any depth, so it would also ignore a directory of that name.
/openledger

# sqlx offline query cache is COMMITTED, not ignored -- ADR-0001 depends on it:
# CI has no database, so `.sqlx/` is what makes the compile-time checking run
# there. Do not add it here.

# Local
.env
*.log

# The docs site.
#
# `site/content/` IS the documentation -- it is committed and it is the source of
# truth. The one exception is `content/source/`, which site/scripts/sync.mjs
# regenerates from files that have to live elsewhere (the migration, the chart,
# the parked DDL, the Rust). Those are copies, so they are not committed.
/site/node_modules/
/site/.next/
/site/out/
/site/content/source/
# Next.js writes these; they are not this repository's to own.
/site/AGENTS.md
/site/CLAUDE.md
